{
  "name": "home-assistant",
  "version": "1.0.0",
  "description": "Cursor plugin that talks to Home Assistant over the REST API.",
  "type": "module",
  "license": "MIT",
  "author": "Venkat Gokul Reddy Palampally",
  "homepage": "https://github.com/gokivego/grokbot-home-assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/gokivego/grokbot-home-assistant"
  },
  "bin": {
    "home-assistant-mcp": "./bin/server.mjs"
  },
  "files": [
    "bin/server.mjs",
    "src",
    "skills",
    "assets",
    "mcp.json",
    ".cursor-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=bin/server.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test": "node --test --import tsx tests/*.test.ts",
    "start": "node bin/server.mjs",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
